# Dependencies and build output (rebuilt inside the image)
node_modules
.next
out

# npm lockfile — this repo is Yarn-only, must never leak into the build context
package-lock.json

# Version control
.git
.gitignore

# Env files — never bake secrets into the image; runtime env comes from Compose
.env
.env.*
!.env.example

# Editors / tooling
.vscode
.cursor
*.tsbuildinfo

# Tests, docs, and task specs — not needed at runtime
tests
e2e
playwright-report
test-results
blob-report
playwright/.cache
docs
tasks
*.md

# Infra files themselves — not needed inside the build context
Dockerfile
.dockerignore
docker-compose.yml
deploy
