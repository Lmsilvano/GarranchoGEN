# GarranchoGEN — environment variable NAMES only.
# Copy to `.env` and fill locally. Never commit a populated `.env`.
# Source of truth for names: docs/specs/07-deploy-docker.md
#
# Host npm run dev vs Compose app use DIFFERENT connection URIs —
# see docs/deploy.md (127.0.0.1 + docker-compose.dev.yml vs database/auth-ldap).

# --- Runtime ---
NODE_ENV=
PORT=3000
# Absolute path to the binary storage root (documents/{documentId}/...).
DATA_DIR=/data

# --- Database (Phase 3) ---
# Host-dev (with compose.dev overlay): mongodb://…@127.0.0.1:27017/…?authSource=admin
# Compose app service: derived in docker-compose.yml from MONGO_INITDB_* (hostname database).
MONGODB_URI=

# --- Session (Phase 2, ADR-0005) ---
SESSION_SECRET=
# Assumed default in specs: 28800 (8h). Required at runtime — no silent fallback.
SESSION_TTL_SECONDS=

# --- LDAP auth (Phase 2) ---
# Host-dev: ldap://127.0.0.1:389 (needs docker-compose.dev.yml). Compose app: ldap://auth-ldap:389
LDAP_URL=
LDAP_BASE_DN=
# Template example: uid={uid},ou=people,{base}
LDAP_USER_DN_TEMPLATE=
# Assumed default in specs: 3600 (1h). Required at runtime — no silent fallback.
LDAP_REVALIDATE_SECONDS=

# --- Gemini HTR (Phase 6). Server-only: never prefix with NEXT_PUBLIC_. ---
GEMINI_API_KEY=
# Empty/unset → default model id gemini-3.6-flash (H-A1).
GEMINI_MODEL=
# Empty/unset → 1 (in-process semaphore; not a claimed remote RPM).
GEMINI_MAX_CONCURRENT=
# Empty/unset → assumed defaults (not SLOs): 5000 / 300000 / 5 / 120000.
GEMINI_RETRY_BASE_MS=
GEMINI_RETRY_MAX_MS=
GEMINI_MAX_ATTEMPTS=
GEMINI_TIMEOUT_MS=

# --- Google OIDC (Phases 9–11, ADR-0009). Client secret is SERVER-ONLY. ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Optional Escriba monthly HTR cap override (assumption A-PS-02 = 20). Not a researched fact.
FREE_PLAN_MONTHLY_HTR_LIMIT=

# --- Transactional email (Phase 13, Nodemailer SMTP). SERVER-ONLY secrets. ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# e.g. GarranchoGEN <noreply@example.com>
MAIL_FROM=
# Public origin for reset links, no trailing slash (e.g. https://app.example.com)
APP_ORIGIN=

# --- Upload limits (Phase 4) ---
# Server hard cap in bytes → 413 when exceeded (required at runtime).
MAX_UPLOAD_BYTES=
# Browser longest-edge resize before upload (optional; invalid/empty = no resize).
NEXT_PUBLIC_MAX_UPLOAD_EDGE_PX=

# --- Job poller (Phase 5) ---
# Required at runtime — no silent fallback.
JOB_LOCK_TTL_MS=
JOB_POLL_INTERVAL_MS=
# Optional; default 2, must be 1 or 2 (Worker Thread pool for sharp).
ENHANCEMENT_WORKER_POOL_SIZE=

# --- database (MongoDB bootstrap, docker-compose.yml only) ---
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=
MONGO_INITDB_DATABASE=

# --- auth-ldap (vegardit/openldap bootstrap, docker-compose.yml only) ---
# LDAP_BASE_DN above doubles as this server's org DN (LDAP_INIT_ORG_DN).
LDAP_INIT_ORG_NAME=
LDAP_INIT_ROOT_USER_DN=
LDAP_INIT_ROOT_USER_PW=

# --- ldap-ui (phpldapadmin/phpldapadmin bootstrap, docker-compose.yml only) ---
# Binds with LDAP_INIT_ROOT_USER_DN/_PW above; LDAP_BASE_DN is reused too.
LDAP_UI_APP_KEY=

# --- reverse-proxy (Caddy, ADR-0004) ---
DOMAIN=
